{
  "name": "usam-frontend-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "USAM final frontend — clean rebuild from first principles (Decision A). Backend/product is source of truth; the deployed frontend/ is a regression oracle only. NOT a permanent second frontend: this tree replaces frontend/ once proven.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:home-bundle": "node scripts/check-home-bundle.mjs",
    "verify:preview": "node scripts/preview-verify.mjs",
    "qa:screenshots": "node scripts/preview-screenshots.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "i18next": "^23.15.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "playwright": "^1.48.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
  }
}
