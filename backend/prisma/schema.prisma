// This is your Prisma schema file
// Complete schema for USAM Learning Worlds - Phase 1 Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// IDENTITY (8 tables)
// ============================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  learner  Learner?
  guardian Guardian?

  @@index([email])
  @@map("users")
}

enum Role {
  LEARNER
  GUARDIAN
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model Learner {
  id                String        @id @default(uuid())
  userId            String        @unique
  firstName         String
  lastName          String?
  displayName       String        @unique
  ageBand           AgeBand?
  avatarUrl         String?
  dateOfBirth       DateTime?
  status            LearnerStatus @default(ACTIVE)
  preferences       Json?
  leaderboardOptIn  Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianships         Guardianship[]
  progression           Progression?
  masteryRecords        MasteryRecord[]
  evidence              Evidence[]
  missionRuns           MissionRun[]
  projects              Project[]
  conversations         Conversation[]
  characterInteractions CharacterInteraction[]
  characterStates       CharacterState[]
  learnerContexts       LearnerContext[]
  pathProgress          LearningPathProgress[]
  learningEvents        LearningEvent[]
  cosmeticUnlocks       LearnerCosmeticUnlock[]

  @@index([userId])
  @@index([displayName])
  @@map("learners")
}

enum AgeBand {
  AGE_8_9
  AGE_10_11
  AGE_12_14
}

enum LearnerStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

model Guardian {
  id            String    @id @default(uuid())
  userId        String    @unique
  firstName     String
  lastName      String
  phone         String?
  relationship  String?
  controls      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianships Guardianship[]

  @@index([userId])
  @@map("guardians")
}

model Guardianship {
  id           String              @id @default(uuid())
  guardianId   String
  learnerId    String
  relationship GuardianRelationship
  status       GuardianshipStatus  @default(PENDING)
  consentedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  learner  Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([guardianId, learnerId])
  @@index([guardianId])
  @@index([learnerId])
  @@map("guardianships")
}

enum GuardianRelationship {
  PARENT
  GUARDIAN
  TEACHER
  OTHER
}

enum GuardianshipStatus {
  PENDING
  ACTIVE
  REVOKED
}

// ============================================
// CURRICULUM (15 tables - Core models)
// ============================================

model Domain {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills         Skill[]
  learningPaths  LearningPath[]
  contentItems   ContentItem[]

  @@index([slug])
  @@map("domains")
}

model Skill {
  id          String   @id @default(uuid())
  domainId    String
  name        String
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  competencies Competency[]

  @@index([domainId])
  @@index([slug])
  @@map("skills")
}

model Competency {
  id          String   @id @default(uuid())
  skillId     String
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skill            Skill                     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  concepts         Concept[]
  objectives       LearningObjective[]
  masteryRecords   MasteryRecord[]
  prerequisites    CompetencyPrerequisite[] @relation("competency")
  dependents       CompetencyPrerequisite[] @relation("prerequisite")

  @@index([skillId])
  @@map("competencies")
}

model LearningObjective {
  id           String   @id @default(uuid())
  competencyId String
  conceptId    String?
  name         String
  description  String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competency   Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  concept      Concept?       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  activities   Activity[]
  contentItems ContentItem[]

  @@index([competencyId])
  @@index([conceptId])
  @@map("learning_objectives")
}

model Activity {
  id          String         @id @default(uuid())
  objectiveId String
  type        ActivityType
  title       String
  description String?
  content     Json
  difficulty  DifficultyLevel @default(MEDIUM)
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  objective        LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  attempts         ActivityAttempt[]
  missionActivities MissionActivity[]

  @@index([objectiveId])
  @@index([type])
  @@map("activities")
}

enum ActivityType {
  SELECT
  MATCH
  SEQUENCE
  CODE
  EXPLAIN
  CREATE
  SOLVE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  CHALLENGE
}

// ============================================
// MASTERY (6 tables)
// ============================================

model MasteryRecord {
  id            String       @id @default(uuid())
  learnerId     String
  competencyId  String
  state         MasteryState @default(NOT_STARTED)
  confidence    Float        @default(0.0)
  evidenceCount Int          @default(0)
  lastPracticed DateTime?
  reviewDue     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  learner    Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  evidence   Evidence[]

  @@unique([learnerId, competencyId])
  @@index([learnerId])
  @@index([competencyId])
  @@index([state])
  @@index([reviewDue])
  @@map("mastery_records")
}

enum MasteryState {
  NOT_STARTED
  INTRODUCED
  EXPLORING
  PRACTICING
  DEVELOPING
  PROFICIENT
  MASTERED
}

model Evidence {
  id             String       @id @default(uuid())
  learnerId      String
  competencyId   String
  masteryId      String
  type           EvidenceType
  success        Boolean
  score          Float?
  context        Json?
  attemptId      String?
  createdAt      DateTime     @default(now())

  learner  Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  mastery  MasteryRecord @relation(fields: [masteryId], references: [id], onDelete: Cascade)
  attempt  ActivityAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([learnerId])
  @@index([masteryId])
  @@index([competencyId])
  @@index([type])
  @@index([createdAt])
  @@map("evidence")
}

enum EvidenceType {
  KNOWLEDGE
  APPLICATION
  CREATION
  EXPLANATION
  CONVERSATION
  PROBLEM_SOLVING
  TRANSFER
  REFLECTION
}

// ============================================
// MISSIONS (12 tables - Core models)
// ============================================

model Mission {
  id                String   @id @default(uuid())
  worldId           String?
  title             String
  description       String
  type              MissionType
  estimatedMinutes  Int?
  order             Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  runs              MissionRun[]
  missionActivities MissionActivity[]

  @@index([type])
  @@map("missions")
}

enum MissionType {
  GUIDED
  EXPLORATION
  CHALLENGE
  PROJECT_BASED
}

model MissionRun {
  id                 String          @id @default(uuid())
  learnerId          String
  missionId          String
  status             MissionRunStatus @default(IN_PROGRESS)
  currentStageIndex  Int             @default(0)
  startedAt          DateTime        @default(now())
  completedAt        DateTime?
  updatedAt          DateTime        @updatedAt

  learner  Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  mission  Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  attempts ActivityAttempt[]

  @@index([learnerId])
  @@index([missionId])
  @@index([status])
  @@map("mission_runs")
}

enum MissionRunStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model ActivityAttempt {
  id         String   @id @default(uuid())
  runId      String
  activityId String
  response   Json
  success    Boolean
  score      Float?
  feedback   String?
  createdAt  DateTime @default(now())

  run      MissionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  activity Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([runId])
  @@index([activityId])
  @@map("activity_attempts")
}

// ============================================
// PROJECTS (8 tables - Core models)
// ============================================

model Project {
  id          String         @id @default(uuid())
  learnerId   String
  title       String
  description String?
  state       ProjectState   @default(DRAFT)
  visibility  ProjectVisibility @default(PRIVATE)
  skills      String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  learner    Learner            @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  milestones ProjectMilestone[]

  @@index([learnerId])
  @@index([state])
  @@map("projects")
}

enum ProjectState {
  DRAFT
  PLANNING
  BUILDING
  REVIEW
  REVISION
  COMPLETED
  SHOWCASED
}

enum ProjectVisibility {
  PRIVATE
  GUARDIANS_ONLY
  PUBLIC
}

// ============================================
// PROGRESSION (10 tables - Core models)
// ============================================

model Progression {
  id        String   @id @default(uuid())
  learnerId String   @unique
  level     Int      @default(1)
  totalXP   Int      @default(0)
  coins     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learner Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  xpGains XPGain[]

  @@index([learnerId])
  @@map("progression")
}

model XPGain {
  id             String   @id @default(uuid())
  learnerId      String
  amount         Int
  source         XPSource
  sourceId       String
  reason         String?
  createdAt      DateTime @default(now())

  progression Progression @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, source, sourceId])
  @@index([learnerId])
  @@index([source])
  @@map("xp_gains")
}

enum XPSource {
  MISSION_COMPLETE
  ACTIVITY_SUCCESS
  PROJECT_COMPLETE
  ACHIEVEMENT_UNLOCK
  STREAK_BONUS
  FIRST_TIME_BONUS
}

model PracticeStreak {
  id                String   @id @default(uuid())
  learnerId         String   @unique
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastPracticeDate  DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([learnerId])
  @@map("practice_streaks")
}

// ============================================
// CHARACTERS & AI (8 tables - Core models)
// ============================================

model Character {
  id           String   @id @default(uuid())
  name         String   @unique
  role         CharacterRole
  personality  Json
  systemPrompt String   @db.Text
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations Conversation[]
  interactions  CharacterInteraction[]
  states        CharacterState[]

  @@index([role])
  @@map("characters")
}

enum CharacterRole {
  GUIDE
  MENTOR
  COMPANION
  CHALLENGER
  ENGLISH_COACH
  CODING_MENTOR
  AI_MENTOR
  CREATIVE_MENTOR
  SCIENCE_MENTOR
  ENTREPRENEURSHIP_MENTOR
  STORY_GUIDE
  CHALLENGE_MASTER
  PROJECT_REVIEWER
  WORLD_GUIDE
  DIGITAL_GUARDIAN
}

// ============================================
// AI & SAFETY (3 tables)
// ============================================

model AIUsageLog {
  id           String   @id @default(uuid())
  userId       String
  service      String
  model        String
  inputTokens  Int
  outputTokens Int
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([service])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

model ModerationLog {
  id             String   @id @default(uuid())
  contentType    String
  contentPreview String   @db.Text
  flagged        Boolean
  categories     String[]
  severity       String
  action         String
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([flagged])
  @@index([severity])
  @@index([createdAt])
  @@map("moderation_logs")
}

model QuarantinedContent {
  id         String    @id @default(uuid())
  entityType String
  entityId   String
  reason     String    @db.Text
  severity   String
  categories String[]
  status     String
  reviewedBy String?
  reviewedAt DateTime?
  reviewNotes String?  @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([status])
  @@index([severity])
  @@map("quarantined_content")
}

// ============================================
// PHASE 3: AI CONVERSATIONS (5 tables)
// ============================================

model Conversation {
  id              String             @id @default(uuid())
  learnerId       String
  characterId     String
  sessionId       String?
  type            ConversationType
  status          ConversationStatus @default(ACTIVE)
  contextSnapshot Json?
  startedAt       DateTime           @default(now())
  endedAt         DateTime?

  learner  Learner              @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  character Character            @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([learnerId])
  @@index([characterId])
  @@index([sessionId])
  @@index([status])
  @@map("conversations")
}

model ConversationMessage {
  id               String   @id @default(uuid())
  conversationId   String
  role             MessageRole
  content          String   @db.Text
  metadata         Json?
  moderationResult Json?
  createdAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("conversation_messages")
}

model CharacterInteraction {
  id              String   @id @default(uuid())
  learnerId       String
  characterId     String
  interactionType String
  context         Json?
  request         String?  @db.Text
  response        String   @db.Text
  mood            String?
  createdAt       DateTime @default(now())

  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@index([characterId])
  @@index([createdAt])
  @@map("character_interactions")
}

model CharacterState {
  id                String    @id @default(uuid())
  learnerId         String
  characterId       String
  relationshipLevel Int       @default(1)
  interactionCount  Int       @default(0)
  lastInteraction   DateTime?
  preferences       Json?
  updatedAt         DateTime  @updatedAt

  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([learnerId, characterId])
  @@index([learnerId])
  @@index([characterId])
  @@map("character_states")
}

model LearnerContext {
  id                   String   @id @default(uuid())
  learnerId            String
  sessionId            String?
  ageBand              AgeBand
  currentDomainId      String?
  currentMissionId     String?
  currentActivityId    String?
  masterySnapshot      Json
  preferencesSnapshot  Json?
  generatedAt          DateTime @default(now())

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@index([sessionId])
  @@index([generatedAt])
  @@map("learner_contexts")
}

enum ConversationType {
  LEARNING_SUPPORT
  ENGLISH_PRACTICE
  CODING_HELP
  PROJECT_GUIDANCE
  CASUAL
  ROLEPLAY
}

enum ConversationStatus {
  ACTIVE
  PAUSED
  ENDED
  BLOCKED
}

enum MessageRole {
  LEARNER
  CHARACTER
  SYSTEM
}

// ============================================
// PHASE 4: LEARNING GRAPH & PREREQUISITES (4 tables)
// ============================================

model Concept {
  id           String   @id @default(uuid())
  competencyId String
  name         String
  slug         String   @unique
  description  String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competency    Competency            @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  objectives    LearningObjective[]
  prerequisites ConceptPrerequisite[] @relation("concept")
  dependents    ConceptPrerequisite[] @relation("prerequisite")

  @@index([competencyId])
  @@index([slug])
  @@map("concepts")
}

model ConceptPrerequisite {
  id             String           @id @default(uuid())
  conceptId      String
  prerequisiteId String
  type           PrerequisiteType @default(REQUIRED)
  createdAt      DateTime         @default(now())

  concept      Concept @relation("concept", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite Concept @relation("prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([conceptId, prerequisiteId])
  @@index([conceptId])
  @@index([prerequisiteId])
  @@map("concept_prerequisites")
}

model CompetencyPrerequisite {
  id             String           @id @default(uuid())
  competencyId   String
  prerequisiteId String
  type           PrerequisiteType @default(REQUIRED)
  createdAt      DateTime         @default(now())

  competency   Competency @relation("competency", fields: [competencyId], references: [id], onDelete: Cascade)
  prerequisite Competency @relation("prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([competencyId, prerequisiteId])
  @@index([competencyId])
  @@index([prerequisiteId])
  @@map("competency_prerequisites")
}

enum PrerequisiteType {
  REQUIRED
  RECOMMENDED
  COREQUISITE
}

// ============================================
// PHASE 4: LEARNING PATHS (3 tables)
// ============================================

model LearningPath {
  id          String   @id @default(uuid())
  domainId    String
  name        String
  slug        String   @unique
  description String?
  ageBand     AgeBand?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain   Domain                 @relation(fields: [domainId], references: [id], onDelete: Cascade)
  nodes    LearningPathNode[]
  progress LearningPathProgress[]

  @@index([domainId])
  @@index([slug])
  @@map("learning_paths")
}

model LearningPathNode {
  id         String   @id @default(uuid())
  pathId     String
  entityType String
  entityId   String
  order      Int      @default(0)
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@index([pathId])
  @@index([entityType, entityId])
  @@map("learning_path_nodes")
}

model LearningPathProgress {
  id               String   @id @default(uuid())
  learnerId        String
  pathId           String
  currentNodeIndex Int      @default(0)
  completedNodes   String[]
  startedAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  learner Learner      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  path    LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([learnerId, pathId])
  @@index([learnerId])
  @@index([pathId])
  @@map("learning_path_progress")
}

// ============================================
// PHASE 4: MISSION-ACTIVITY LINKAGE (1 table)
// ============================================

model MissionActivity {
  id         String   @id @default(uuid())
  missionId  String
  activityId String
  order      Int      @default(0)
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  mission  Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([missionId, activityId])
  @@index([missionId])
  @@index([activityId])
  @@map("mission_activities")
}

// ============================================
// PHASE 4: AGE ADAPTATION (1 table)
// ============================================

model AgeVariant {
  id            String        @id @default(uuid())
  entityType    String
  entityId      String
  ageBand       AgeBand
  framing       String
  languageLevel String?
  scaffoldLevel ScaffoldLevel @default(GUIDED)
  surface       String?
  content       Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([entityType, entityId, ageBand])
  @@index([entityType, entityId])
  @@index([ageBand])
  @@map("age_variants")
}

enum ScaffoldLevel {
  MODELLED
  GUIDED
  COACHED
  INDEPENDENT
}

// ============================================
// PHASE 4: CONTENT MANAGEMENT (1 table)
// ============================================

model ContentItem {
  id          String          @id @default(uuid())
  type        ContentType
  title       String
  content     Json
  metadata    Json?
  language    String          @default("en")
  ageBand     AgeBand?
  domainId    String?
  objectiveId String?
  difficulty  DifficultyLevel?
  status      ContentStatus   @default(DRAFT)
  version     Int             @default(1)
  generatedBy String?
  validatedBy String?
  validatedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  domain    Domain?            @relation(fields: [domainId], references: [id], onDelete: SetNull)
  objective LearningObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([domainId])
  @@index([ageBand])
  @@index([generatedBy])
  @@map("content_items")
}

enum ContentType {
  ACTIVITY
  QUESTION
  STORY
  SCENARIO
  HINT
  EXPLANATION
  PROJECT_BRIEF
  PRACTICE_SET
}

enum ContentStatus {
  DRAFT
  VALIDATING
  VALIDATED
  PUBLISHED
  DEPRECATED
  REJECTED
}

// ============================================
// PHASE 4: MULTILINGUAL (1 table)
// ============================================

model Translation {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  field      String
  language   String
  value      String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, field, language])
  @@index([entityType, entityId])
  @@index([language])
  @@map("translations")
}

// ============================================
// PHASE 4: LEARNING EVENTS (1 table)
// ============================================

model LearningEvent {
  id         String            @id @default(uuid())
  learnerId  String
  type       LearningEventType
  entityType String?
  entityId   String?
  data       Json?
  sessionId  String?
  createdAt  DateTime          @default(now())

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
  @@index([entityType, entityId])
  @@map("learning_events")
}

enum LearningEventType {
  ACTIVITY_STARTED
  ACTIVITY_COMPLETED
  ANSWER_SUBMITTED
  HINT_REQUESTED
  EXPLANATION_REQUESTED
  MASTERY_CHANGED
  PROJECT_STARTED
  PROJECT_COMPLETED
  MISSION_STARTED
  MISSION_COMPLETED
  CONVERSATION_STARTED
  SKILL_UNLOCKED
  CONCEPT_UNLOCKED
  ACHIEVEMENT_EARNED
  PRACTICE_STREAK_UPDATED
  REVIEW_SCHEDULED
  ASSESSMENT_STARTED
  ASSESSMENT_COMPLETED
}

// ============================================
// PHASE 4: PROJECT ENHANCEMENTS (3 tables)
// ============================================

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?
  targetDate  DateTime?
  status      String    @default("PENDING")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("project_milestones")
}

model Rubric {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  criteria RubricCriterion[]

  @@index([entityType, entityId])
  @@map("rubrics")
}

model RubricCriterion {
  id          String   @id @default(uuid())
  rubricId    String
  name        String
  description String
  order       Int      @default(0)
  levels      Json
  createdAt   DateTime @default(now())

  rubric Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  @@index([rubricId])
  @@map("rubric_criteria")
}

