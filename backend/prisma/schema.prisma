  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([slug])
  @@index([category])
  @@map("entrepreneurship_concepts")
}

model FinancialLiteracyConcept {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  category        String
  ageAppropriate  AgeBand
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([slug])
  @@index([category])
  @@map("financial_literacy_concepts")
}

// ==================== Cosmetic Shop (XP-spending economy) ====================
// Real "spend your XP" loop: learners unlock cosmetic items (borders, badges,
// titles, dashboard color themes) by spending earned XP. Server-side atomic
// balance check + deduction lives in CosmeticsService; this is just storage.
enum CosmeticCategory {
  BORDER
  BADGE
  TITLE
  COLOR_THEME
}

model AvatarCosmetic {
  id              String            @id @default(uuid())
  name            String            @unique
  category        CosmeticCategory
  xpCost          Int
  iconOrStyleKey  String
  isDefault       Boolean           @default(false)
  createdAt       DateTime          @default(now())

  unlocks         LearnerCosmeticUnlock[]

  @@index([category])
  @@map("avatar_cosmetics")
}

model LearnerCosmeticUnlock {
  id          String         @id @default(uuid())
  learnerId   String
  cosmeticId  String
  unlockedAt  DateTime       @default(now())
  isEquipped  Boolean        @default(false)

  learner     Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  cosmetic    AvatarCosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([learnerId, cosmeticId])
  @@index([learnerId])
  @@index([cosmeticId])
  @@map("learner_cosmetic_unlocks")
}
