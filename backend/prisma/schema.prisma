model AssessmentQualityFlag {
  id         String    @id @default(uuid())
  activityId String
  flagType   String
  detail     String?
  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

