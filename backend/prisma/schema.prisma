// ============================================
// STORY ENGINE (small, real, honest scope)
//
// A deliberately small branching-story model, NOT a full branching-
// narrative platform. `Story` is the top-level metadata; `StoryPage` is
// one page of a linear-with-branches story where `choiceOptions` (Json)
// holds 2-3 {label, nextPageNumber} choices. The LAST page of any branch
// has an empty/null `choiceOptions` array to signal "the end".
//
// Story Branching Engine (gap matrix) is satisfied by this same
// `choiceOptions` Json structure — see gap matrix note, no separate
// branching-engine model was built.
//
// Story Safety Engine: every StoryPage carries `safetyReviewed` +
// `safetyReviewedAt` + `safetyNotes`, populated by running each page's
// `text` through the existing safety pattern (deterministic Presidio PII
// backstop, the same one ModerationService.moderateContent() uses) at
// seed time, even though this content is human-authored — see
// seed-stories.ts for the actual review calls and honest notes about the
// Bedrock-LLM half of ModerationService being down in production.
// ============================================
model Story {
  id        String   @id @default(uuid())
  title     String
  summary   String
  ageBand   AgeBand
  domainId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain Domain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  pages  StoryPage[]

  @@index([domainId])
  @@index([ageBand])
  @@map("stories")
}

model StoryPage {
  id               String    @id @default(uuid())
  storyId          String
  pageNumber       Int
  text             String
  // Array of { label: string, nextPageNumber: number | null } — 2-3
  // entries for a branching page, or [] for an ending page.
  choiceOptions    Json
  // Story Safety Engine fields — this page's `text` was run through the
  // deterministic PII backstop at authoring time.
  safetyReviewed   Boolean   @default(false)
  safetyReviewedAt DateTime?
  safetyNotes      String?

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, pageNumber])
  @@index([storyId])
  @@map("story_pages")
}

