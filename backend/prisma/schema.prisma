// This is your Prisma schema file
// Complete schema for USAM Learning Worlds - Phase 1 Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// IDENTITY (8 tables)
// ============================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  learner  Learner?
  guardian Guardian?

  @@index([email])
  @@map("users")
}

enum Role {
  LEARNER
  GUARDIAN
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model Learner {
  id               String        @id @default(uuid())
  userId           String        @unique
  firstName        String
  lastName         String?
  displayName      String        @unique
  ageBand          AgeBand?
  avatarUrl        String?
  dateOfBirth      DateTime?
  status           LearnerStatus @default(ACTIVE)
  preferences      Json?
  leaderboardOptIn Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianships         Guardianship[]
  progression           Progression?
  masteryRecords        MasteryRecord[]
  evidence              Evidence[]
  missionRuns           MissionRun[]
  projects              Project[]
  conversations         Conversation[]
  characterInteractions CharacterInteraction[]
  characterStates       CharacterState[]
  learnerContexts       LearnerContext[]
  pathProgress          LearningPathProgress[]
  learningEvents        LearningEvent[]
  cosmeticUnlocks       LearnerCosmeticUnlock[]
  missionReflections    MissionReflection[]
  flashcardReviews      FlashcardReview[]
  dailyGoal             DailyGoal?
  notifications         Notification[]
  projectCollaborations ProjectCollaborator[]
  researchNotes         ResearchNote[]
  creativitySubmissions CreativitySubmission[]
  cognitiveLoadSignals  CognitiveLoadSignal[]
  interventions         InterventionRecommendation[]
  safetyEscalations     SafetyEscalation[]

  @@index([userId])
  @@index([displayName])
  @@map("learners")
}

enum AgeBand {
  AGE_8_9
  AGE_10_11
  AGE_12_14
}

enum LearnerStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

model Guardian {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String
  lastName     String
  phone        String?
  relationship String?
  controls     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianships Guardianship[]

  @@index([userId])
  @@map("guardians")
}

model Guardianship {
  id           String               @id @default(uuid())
  guardianId   String
  learnerId    String
  relationship GuardianRelationship
  status       GuardianshipStatus   @default(PENDING)
  consentedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  learner  Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([guardianId, learnerId])
  @@index([guardianId])
  @@index([learnerId])
  @@map("guardianships")
}

enum GuardianRelationship {
  PARENT
  GUARDIAN
  TEACHER
  OTHER
}

enum GuardianshipStatus {
  PENDING
  ACTIVE
  REVOKED
}

// ============================================
// CURRICULUM (15 tables - Core models)
// ============================================

model Domain {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills            Skill[]
  learningPaths     LearningPath[]
  contentItems      ContentItem[]
  worlds            World[]
  creativityPrompts CreativityPrompt[]
  stories           Story[]
  flashcards        Flashcard[]

  @@index([slug])
  @@map("domains")
}

model Skill {
  id          String   @id @default(uuid())
  domainId    String
  name        String
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  competencies Competency[]

  @@index([domainId])
  @@index([slug])
  @@map("skills")
}

model Competency {
  id          String   @id @default(uuid())
  skillId     String
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skill          Skill                    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  concepts       Concept[]
  objectives     LearningObjective[]
  masteryRecords MasteryRecord[]
  prerequisites  CompetencyPrerequisite[] @relation("competency")
  dependents     CompetencyPrerequisite[] @relation("prerequisite")
  projects       Project[]
  interventions  InterventionRecommendation[]

  @@index([skillId])
  @@map("competencies")
}

model LearningObjective {
  id           String   @id @default(uuid())
  competencyId String
  conceptId    String?
  name         String
  description  String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competency        Competency         @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  concept           Concept?           @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  activities        Activity[]
  contentItems      ContentItem[]
  projects          Project[]
  questionTemplates QuestionTemplate[]

  @@index([competencyId])
  @@index([conceptId])
  @@map("learning_objectives")
}

model Activity {
  id                      String            @id @default(uuid())
  objectiveId             String
  type                    ActivityType
  title                   String
  description             String?
  content                 Json
  difficulty              DifficultyLevel   @default(MEDIUM)
  assessmentPurpose       AssessmentPurpose @default(FORMATIVE)
  order                   Int               @default(0)
  isActive                Boolean           @default(true)
  generatedFromTemplateId String?
  // Bloom Engine (SMALL, manual-tagging version — see gap matrix Bloom
  // Engine row). Each seeded activity below is manually tagged with the
  // cognitive level it actually exercises, NOT auto-classified — there is
  // no NLP/heuristic classifier here. Auto-classification of arbitrary
  // future content remains genuinely Missing; this field + the
  // /missions/activities/by-bloom-level/:level filter are the real,
  // small, honest slice: manual data + a real filter over it.
  bloomLevel              BloomLevel?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  objective             LearningObjective      @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  attempts              ActivityAttempt[]
  missionActivities     MissionActivity[]
  generatedFromTemplate QuestionTemplate?      @relation("GeneratedFromTemplate", fields: [generatedFromTemplateId], references: [id], onDelete: SetNull)
  cognitiveLoadSignals  CognitiveLoadSignal[]
  misconceptionPatterns MisconceptionPattern[]
  qualityFlags          AssessmentQualityFlag[]

  @@index([objectiveId])
  @@index([type])
  @@index([assessmentPurpose])
  @@index([generatedFromTemplateId])
  @@index([bloomLevel])
  @@map("activities")
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum AssessmentPurpose {
  DIAGNOSTIC
  FORMATIVE
  SUMMATIVE
}

enum ActivityType {
  SELECT
  MATCH
  SEQUENCE
  CODE
  EXPLAIN
  CREATE
  SOLVE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  CHALLENGE
}

// ============================================
// MASTERY (6 tables)
// ============================================

model MasteryRecord {
  id            String       @id @default(uuid())
  learnerId     String
  competencyId  String
  state         MasteryState @default(NOT_STARTED)
  confidence    Float        @default(0.0)
  evidenceCount Int          @default(0)
  lastPracticed DateTime?
  reviewDue     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  learner    Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  evidence   Evidence[]

  @@unique([learnerId, competencyId])
  @@index([learnerId])
  @@index([competencyId])
  @@index([state])
  @@index([reviewDue])
  @@map("mastery_records")
}

enum MasteryState {
  NOT_STARTED
  INTRODUCED
  EXPLORING
  PRACTICING
  DEVELOPING
  PROFICIENT
  MASTERED
}

model Evidence {
  id           String       @id @default(uuid())
  learnerId    String
  competencyId String
  masteryId    String
  type         EvidenceType
  success      Boolean
  score        Float?
  context      Json?
  attemptId    String?
  createdAt    DateTime     @default(now())

  learner Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  mastery MasteryRecord    @relation(fields: [masteryId], references: [id], onDelete: Cascade)
  attempt ActivityAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([learnerId])
  @@index([masteryId])
  @@index([competencyId])
  @@index([type])
  @@index([createdAt])
  @@map("evidence")
}

enum EvidenceType {
  KNOWLEDGE
  APPLICATION
  CREATION
  EXPLANATION
  CONVERSATION
  PROBLEM_SOLVING
  TRANSFER
  REFLECTION
}

// ============================================
// MISSIONS (12 tables - Core models)
// ============================================

model Mission {
  id               String      @id @default(uuid())
  worldId          String?
  title            String
  description      String
  type             MissionType
  estimatedMinutes Int?
  order            Int         @default(0)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  world             World?            @relation(fields: [worldId], references: [id], onDelete: SetNull)
  runs              MissionRun[]
  missionActivities MissionActivity[]

  @@index([type])
  @@index([worldId])
  @@map("missions")
}

// ==================== World Engine / World State Engine ====================
// Zero-trace engine per USAM_KIDS_ENGINE_GAP_MATRIX.md Part 7b — before this
// pass, `Mission.worldId` was a nullable, unindexed, unvalidated free string
// with no World model, no FK, no relation, no seed data, no controller
// route, and no frontend reference. Built from scratch this pass: a real
// World model that Mission.worldId now genuinely references (migrated from
// free string to FK), one World per major Domain (a "zone" learners travel
// to for that subject), and a real per-learner unlock-status signal reusing
// the same domain-engagement pattern character.service.ts's
// getUnlockedCharactersForLearner() established (getDomainEngagementSet()).
model World {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  domainId        String
  unlockCondition String
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  domain   Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  missions Mission[]

  @@index([domainId])
  @@index([slug])
  @@map("worlds")
}

enum MissionType {
  GUIDED
  EXPLORATION
  CHALLENGE
  PROJECT_BASED
}

model MissionRun {
  id                String           @id @default(uuid())
  learnerId         String
  missionId         String
  status            MissionRunStatus @default(IN_PROGRESS)
  currentStageIndex Int              @default(0)
  startedAt         DateTime         @default(now())
  completedAt       DateTime?
  updatedAt         DateTime         @updatedAt

  learner              Learner               @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  mission              Mission               @relation(fields: [missionId], references: [id], onDelete: Cascade)
  attempts             ActivityAttempt[]
  reflections          MissionReflection[]
  cognitiveLoadSignals CognitiveLoadSignal[]

  @@index([learnerId])
  @@index([missionId])
  @@index([status])
  @@map("mission_runs")
}

enum MissionRunStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model ActivityAttempt {
  id         String   @id @default(uuid())
  runId      String
  activityId String
  response   Json
  success    Boolean
  score      Float?
  feedback   String?
  createdAt  DateTime @default(now())

  run                  MissionRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  activity             Activity              @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evidence             Evidence[]
  cognitiveLoadSignals CognitiveLoadSignal[]

  @@index([runId])
  @@index([activityId])
  @@map("activity_attempts")
}

// ============================================
// PROJECTS (8 tables - Core models)
// ============================================

model Project {
  id                   String            @id @default(uuid())
  learnerId            String
  title                String
  description          String?
  state                ProjectState      @default(DRAFT)
  visibility           ProjectVisibility @default(PRIVATE)
  skills               String[]
  competencyId         String?
  objectiveId          String?
  isRealWorldChallenge Boolean           @default(false)
  externalSourceUrl    String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  learner       Learner               @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  competency    Competency?           @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  objective     LearningObjective?    @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  milestones    ProjectMilestone[]
  collaborators ProjectCollaborator[]
  researchNotes ResearchNote[]

  @@index([learnerId])
  @@index([state])
  @@index([competencyId])
  @@index([isRealWorldChallenge])
  @@map("projects")
}

enum ProjectCollaboratorRole {
  EDITOR
  COMMENTER
}

model ProjectCollaborator {
  id        String                  @id @default(uuid())
  projectId String
  learnerId String
  role      ProjectCollaboratorRole @default(EDITOR)
  invitedBy String
  createdAt DateTime                @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([projectId, learnerId])
  @@index([projectId])
  @@index([learnerId])
  @@map("project_collaborators")
}

model ResearchNote {
  id          String   @id @default(uuid())
  projectId   String
  learnerId   String
  content     String
  sourceTitle String?
  sourceUrl   String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([learnerId])
  @@map("research_notes")
}

enum ProjectState {
  DRAFT
  PLANNING
  BUILDING
  REVIEW
  REVISION
  COMPLETED
  SHOWCASED
}

enum ProjectVisibility {
  PRIVATE
  GUARDIANS_ONLY
  PUBLIC
}

// ============================================
// PROGRESSION (10 tables - Core models)
// ============================================

model Progression {
  id        String   @id @default(uuid())
  learnerId String   @unique
  level     Int      @default(1)
  totalXP   Int      @default(0)
  coins     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learner Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  xpGains XPGain[]

  @@index([learnerId])
  @@map("progression")
}

model XPGain {
  id        String   @id @default(uuid())
  learnerId String
  amount    Int
  source    XPSource
  sourceId  String
  reason    String?
  createdAt DateTime @default(now())

  progression Progression @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, source, sourceId])
  @@index([learnerId])
  @@index([source])
  @@map("xp_gains")
}

enum XPSource {
  MISSION_COMPLETE
  ACTIVITY_SUCCESS
  PROJECT_COMPLETE
  ACHIEVEMENT_UNLOCK
  STREAK_BONUS
  FIRST_TIME_BONUS
}

model PracticeStreak {
  id               String    @id @default(uuid())
  learnerId        String    @unique
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastPracticeDate DateTime
  // Coin-spending economy: learners buy freeze tokens (see StreakFreezePurchase)
  // that get consumed here instead of the streak resetting on a missed day.
  freezesAvailable Int       @default(0)
  lastFreezeUsedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([learnerId])
  @@map("practice_streaks")
}

// Real coin-spending economy (distinct from the XP-spending cosmetic shop):
// learners spend Progression.coins to buy a Streak Freeze — a Duolingo-pattern
// token that protects their streak the next time they miss a practice day.
// One row per purchase gives a real, auditable ledger of coin spend.
model StreakFreezePurchase {
  id          String    @id @default(uuid())
  learnerId   String
  coinsCost   Int
  purchasedAt DateTime  @default(now())
  usedAt      DateTime?

  @@index([learnerId])
  @@map("streak_freeze_purchases")
}

// ============================================
// CHARACTERS & AI (8 tables - Core models)
// ============================================

model Character {
  id           String        @id @default(uuid())
  name         String        @unique
  role         CharacterRole
  personality  Json
  systemPrompt String        @db.Text
  avatarUrl    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  conversations Conversation[]
  interactions  CharacterInteraction[]
  states        CharacterState[]

  @@index([role])
  @@map("characters")
}

enum CharacterRole {
  GUIDE
  MENTOR
  COMPANION
  CHALLENGER
  ENGLISH_COACH
  CODING_MENTOR
  AI_MENTOR
  CREATIVE_MENTOR
  SCIENCE_MENTOR
  ENTREPRENEURSHIP_MENTOR
  STORY_GUIDE
  CHALLENGE_MASTER
  PROJECT_REVIEWER
  WORLD_GUIDE
  DIGITAL_GUARDIAN
}

// ============================================
// AI & SAFETY (3 tables)
// ============================================

model AIUsageLog {
  id           String   @id @default(uuid())
  userId       String
  service      String
  model        String
  inputTokens  Int
  outputTokens Int
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([service])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

model ModerationLog {
  id             String    @id @default(uuid())
  contentType    String
  contentPreview String    @db.Text
  flagged        Boolean
  categories     String[]
  severity       String
  action         String
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([flagged])
  @@index([severity])
  @@index([createdAt])
  @@map("moderation_logs")
}

// SafetyEscalation records a real, persisted, actionable escalation
// whenever CharacterSafetyService.evaluateSafety() resolves to the
// 'escalation_required' SafetyState. Previously that state was only
// written into the generic ModerationLog free-form fields with no
// assignee/status/resolution workflow — i.e. HIGH-severity character
// safety events for children had nowhere real to escalate to. This
// model is the fix: a first-class queue a moderator/admin can list,
// claim (assignedTo), and resolve.
model SafetyEscalation {
  id            String                 @id @default(uuid())
  learnerId     String
  triggerReason String                 @db.Text
  safetyState   String
  status        SafetyEscalationStatus @default(OPEN)
  assignedTo    String?
  resolvedAt    DateTime?
  createdAt     DateTime               @default(now())

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([learnerId])
  @@index([createdAt])
  @@map("safety_escalations")
}

enum SafetyEscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model QuarantinedContent {
  id          String    @id @default(uuid())
  entityType  String
  entityId    String
  reason      String    @db.Text
  severity    String
  categories  String[]
  status      String
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([status])
  @@index([severity])
  @@map("quarantined_content")
}

// ============================================
// PHASE 3: AI CONVERSATIONS (5 tables)
// ============================================

model Conversation {
  id              String             @id @default(uuid())
  learnerId       String
  characterId     String
  sessionId       String?
  type            ConversationType
  status          ConversationStatus @default(ACTIVE)
  contextSnapshot Json?
  startedAt       DateTime           @default(now())
  endedAt         DateTime?

  learner   Learner               @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  character Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]

  @@index([learnerId])
  @@index([characterId])
  @@index([sessionId])
  @@index([status])
  @@map("conversations")
}

model ConversationMessage {
  id               String      @id @default(uuid())
  conversationId   String
  role             MessageRole
  content          String      @db.Text
  metadata         Json?
  moderationResult Json?
  createdAt        DateTime    @default(now())
  /// AI Memory Governance: number of days this message may be retained
  /// before a purge job/query is allowed to delete it. Defaults to 180
  /// days for conversation transcripts (longer than ephemeral
  /// LearnerContext snapshots since parents/moderators may need to
  /// review a conversation after the fact), per docs/architecture/
  /// USAM_KIDS_ENGINE_GAP_MATRIX.md "AI Memory Governance" row.
  retentionDays    Int         @default(180)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("conversation_messages")
}

model CharacterInteraction {
  id              String   @id @default(uuid())
  learnerId       String
  characterId     String
  interactionType String
  context         Json?
  request         String?  @db.Text
  response        String   @db.Text
  mood            String?
  createdAt       DateTime @default(now())

  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@index([characterId])
  @@index([createdAt])
  @@map("character_interactions")
}

model CharacterState {
  id                String    @id @default(uuid())
  learnerId         String
  characterId       String
  relationshipLevel Int       @default(1)
  interactionCount  Int       @default(0)
  lastInteraction   DateTime?
  preferences       Json?
  updatedAt         DateTime  @updatedAt

  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([learnerId, characterId])
  @@index([learnerId])
  @@index([characterId])
  @@map("character_states")
}

model LearnerContext {
  id                  String   @id @default(uuid())
  learnerId           String
  sessionId           String?
  ageBand             AgeBand
  currentDomainId     String?
  currentMissionId    String?
  currentActivityId   String?
  masterySnapshot     Json
  preferencesSnapshot Json?
  generatedAt         DateTime @default(now())
  /// AI Memory Governance: number of days this snapshot may be retained
  /// before a purge job/query is allowed to delete it. Defaults to 90
  /// days - context snapshots are ephemeral personalization inputs, not
  /// permanent records, per docs/architecture/USAM_KIDS_ENGINE_GAP_MATRIX.md
  /// "AI Memory Governance" row (no retention-policy metadata existed
  /// before this field).
  retentionDays       Int      @default(90)

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@index([sessionId])
  @@index([generatedAt])
  @@map("learner_contexts")
}

// AI Prompt/Policy Engine (small, real version): a versioned,
// centrally-managed store for the system prompts that were previously
// hardcoded inline in character.service.ts / moderation.service.ts /
// coding-coach.service.ts / english-coach.service.ts. Each row is one
// named template (`key`) with a `version` number and `changelog` text
// describing what changed at that version, plus `isActive` so a
// template can be soft-disabled (falling back to the caller's inline
// default) without deleting history. Not a full policy-approval/A-B
// testing platform - a real, small "read the prompt from a table
// instead of a string literal" refactor. See docs/architecture/
// USAM_KIDS_ENGINE_GAP_MATRIX.md "AI Prompt/Policy Engine" row.
model PromptTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  content   String   @db.Text
  version   Int      @default(1)
  changelog String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("prompt_templates")
}

